{
  "name": "conferencia-bolao",
  "private": true,
  "version": "3.0.0",
  "description": "Bolão de futebol entre amigos: React + Node.js (Hono) + MySQL.",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"server/**/*.test.ts\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "bcryptjs": "^3.0.3",
    "esbuild": "^0.28.2",
    "hono": "^4.13.14",
    "lucide-react": "^1.64.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15"
  }
}
